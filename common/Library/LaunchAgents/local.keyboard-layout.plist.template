<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  keyboard-layout watcher daemon.
  install-keyboard-layout.sh substitutes __DOTFILES__ / __HOME__.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.keyboard-layout</string>

    <key>ProgramArguments</key>
    <array>
        <string>__DOTFILES__/scripts/darwin/bin/keyboard-watcher</string>
        <string>run</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Background</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin:__HOME__/.bun/bin</string>
        <key>DOTFILES_DIR</key>
        <string>__DOTFILES__</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/keyboard-layout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/keyboard-layout.log</string>
</dict>
</plist>
