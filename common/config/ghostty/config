font-family = UDEV Gothic 35LG
font-size = 13
font-feature = [ "-dlig" ]

theme = Kanagawa Dragon

shell-integration = bash
shell-integration-features = no-cursor

window-decoration = none

background-opacity = 0.80
background-blur = 100
background-image-opacity = 1.0
background-image-fit = cover

# Daily wallpaper selection; see wallpapers/rotate.sh.
config-file = ?~/.local/state/ghostty/wallpaper.conf

unfocused-split-opacity = 0.90
unfocused-split-fill = #1e1e2e

split-divider-color = #45475a

scrollback-limit = 10000

cursor-style = block
cursor-style-blink = false

keybind = cmd+u=text:\x18\x15

mouse-hide-while-typing = true

working-directory = inherit
